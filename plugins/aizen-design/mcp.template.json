{
  "mcpServers": {
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "penpot": {
      "command": "npx",
      "args": ["-y", "penpot-mcp-server"],
      "env": {
        "PENPOT_TOKEN": "${PENPOT_TOKEN:-}"
      }
    }
  }
}
