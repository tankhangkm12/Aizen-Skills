{
  "name": "aizen-skills",
  "version": "2.1.0",
  "description": "Aizen agent skill suite (entry skills + topic packs, shared core, pinned upstream knowledge) with auto-installation and live-sync for Claude Code, Antigravity / Gemini CLI, Cursor and Windsurf.",
  "main": "bin/cli.js",
  "bin": {
    "aizen": "./bin/cli.js",
    "aizen-skills": "./bin/cli.js"
  },
  "scripts": {
    "postinstall": "node ./bin/install.js --auto",
    "install:skills": "node ./bin/cli.js install",
    "sync": "node ./bin/cli.js sync",
    "update:skills": "node ./bin/cli.js update",
    "status": "node ./bin/cli.js status",
    "test": "node ./tests/check-skills.js && node ./tests/check-scripts.js && node ./tests/test-installer.js && node ./tests/test-external.js",
    "vendor": "node ./bin/vendor.js",
    "external": "node ./bin/external.js"
  },
  "keywords": [
    "antigravity",
    "ai-agent",
    "skills",
    "claude-code",
    "cursor",
    "windsurf",
    "cline",
    "roo-code",
    "copilot"
  ],
  "author": "Aizen Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "skills",
    "rules",
    "plugin.json",
    "README.md",
    "LICENSE",
    "vendor.lock.json",
    "externals.json"
  ]
}
